<mxfile host="app.diagrams.net" modified="2026-10-30T15:45:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="dynamic-register-reception" name="02 - Diagrama dinámico"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Arquitectura · Diagrama dinámico&lt;/b&gt;&lt;br&gt;UC: Registrar un albarán de recepción (RF01–RF07)" style="text;html=1;align=left;verticalAlign=middle;fontSize=23;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1330" height="65" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;Administrativo&lt;/b&gt;&lt;br&gt;Empleado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="55" y="110" width="180" height="75" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;Aplicación web (SPA)&lt;/b&gt;&lt;br&gt;HTML / CSS / JavaScript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="220" height="75" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;API REST / Backend&lt;/b&gt;&lt;br&gt;PHP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#438DD5;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="230" height="75" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;MySQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="210" height="75" as="geometry" /></mxCell><mxCell id="life1" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#A6A6A6;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="190" as="sourcePoint" /><mxPoint x="145.0" y="855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="life2" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#A6A6A6;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="190" as="sourcePoint" /><mxPoint x="455.0" y="855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="life3" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#A6A6A6;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815.0" y="190" as="sourcePoint" /><mxPoint x="815.0" y="855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="life4" value="" style="edgeStyle=none;html=1;dashed=1;dashPattern=6 6;strokeColor=#A6A6A6;endArrow=none;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185.0" y="190" as="sourcePoint" /><mxPoint x="1185.0" y="855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s1" value="&lt;b&gt;1.&lt;/b&gt; Completa el formulario y pulsa “Registrar”." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145.0" y="225" as="sourcePoint" /><mxPoint x="455.0" y="225" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s2" value="&lt;b&gt;2.&lt;/b&gt; POST /api/albaranes · HTTPS · JSON + cookie de sesión" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="285" as="sourcePoint" /><mxPoint x="815.0" y="285" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s3" value="&lt;b&gt;3.&lt;/b&gt; Consulta el usuario y su perfil asociado a la sesión." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815.0" y="345" as="sourcePoint" /><mxPoint x="1185.0" y="345" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s4" value="&lt;b&gt;4.&lt;/b&gt; Devuelve el perfil: ADMINISTRATIVO." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185.0" y="405" as="sourcePoint" /><mxPoint x="815.0" y="405" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s5" value="&lt;b&gt;5.&lt;/b&gt; BEGIN + INSERT del albarán (producto, cantidad, fechas, referencia y proveedor)." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815.0" y="490" as="sourcePoint" /><mxPoint x="1185.0" y="490" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s6" value="&lt;b&gt;6.&lt;/b&gt; Devuelve el identificador del albarán insertado." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185.0" y="550" as="sourcePoint" /><mxPoint x="815.0" y="550" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s7" value="&lt;b&gt;7.&lt;/b&gt; INSERT del registro de actividad (fecha y usuario responsable)." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815.0" y="610" as="sourcePoint" /><mxPoint x="1185.0" y="610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s8" value="&lt;b&gt;8.&lt;/b&gt; COMMIT: confirma la transacción." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1185.0" y="670" as="sourcePoint" /><mxPoint x="815.0" y="670" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s9" value="&lt;b&gt;9.&lt;/b&gt; HTTP 201 Created · identificador y confirmación." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="815.0" y="735" as="sourcePoint" /><mxPoint x="455.0" y="735" as="targetPoint" /></mxGeometry></mxCell><mxCell id="s10" value="&lt;b&gt;10.&lt;/b&gt; Muestra el mensaje de éxito y el albarán registrado." style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#263238;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455.0" y="795" as="sourcePoint" /><mxPoint x="145.0" y="795" as="targetPoint" /></mxGeometry></mxCell><mxCell id="validation-note" value="&lt;b&gt;Validación en la API, antes de guardar:&lt;/b&gt; comprueba campos obligatorios, cantidad y fechas. Si encuentra errores, no inicia la escritura y responde con HTTP 422." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#5B4B00;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="675" y="865" width="310" height="75" as="geometry" /></mxCell><mxCell id="error-note" value="&lt;b&gt;Flujo alternativo:&lt;/b&gt; si falla el almacenamiento, la API ejecuta ROLLBACK y devuelve un error. La SPA conserva lo escrito y señala los campos que deben corregirse (RF04, RF05 y RF50)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontColor=#7A1F1F;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1010" y="865" width="330" height="75" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>