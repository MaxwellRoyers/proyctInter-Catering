<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-30T15:45:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="deployment-catering" name="03 - Diagrama de despliegue"><mxGraphModel dx="1450" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Arquitectura · Diagrama de despliegue&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1380" height="55" as="geometry" /></mxCell><mxCell id="client-node" value="&lt;b&gt;Dispositivo del empleado&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PC de recepción / cocina&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="320" height="410" as="geometry" /></mxCell><mxCell id="browser" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ejecuta la SPA y muestra formularios, consultas y documentos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="95" y="325" width="220" height="145" as="geometry" /></mxCell><mxCell id="server-node" value="&lt;b&gt;Servidor de aplicación&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Una máquina virtual Linux (despliegue inicial)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=12;fontSize=17;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="500" y="115" width="900" height="650" as="geometry" /></mxCell><mxCell id="apache" value="&lt;b&gt;Apache HTTP Server&lt;/b&gt;&lt;br&gt;&lt;br&gt;Termina HTTPS (puerto 443) y sirve la aplicación web." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#274E13;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="235" width="335" height="135" as="geometry" /></mxCell><mxCell id="spa-files" value="&lt;b&gt;Archivos del frontend SPA&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTML, CSS y JavaScript servidos por Apache." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="560" y="445" width="335" height="125" as="geometry" /></mxCell><mxCell id="php-api" value="&lt;b&gt;Backend PHP · API REST&lt;/b&gt;&lt;br&gt;&lt;br&gt;Autenticación, autorización, validaciones, lógica de negocio, acceso a datos y generación de PDF." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="220" width="330" height="190" as="geometry" /></mxCell><mxCell id="mysql" value="&lt;b&gt;Servicio MySQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Base de datos persistente del proyecto. Acceso limitado al propio servidor." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#1168BD;strokeColor=#0B5394;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="495" width="330" height="145" as="geometry" /></mxCell><mxCell id="d1" value="&lt;b&gt;HTTPS · TCP 443&lt;/b&gt;&lt;br&gt;Acceso a la aplicación" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="apache"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d2" value="Entrega de HTML, CSS y JS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apache" target="spa-files"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d3" value="&lt;b&gt;HTTPS · REST/JSON&lt;/b&gt;&lt;br&gt;Solicitudes a /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="php-api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d4" value="Enrutamiento interno de /api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apache" target="php-api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d5" value="&lt;b&gt;SQL · PDO&lt;/b&gt;&lt;br&gt;Conexión local (127.0.0.1:3306)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="php-api" target="mysql"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="deployment-note" value="&lt;b&gt;Decisión de despliegue:&lt;/b&gt; para el volumen y alcance iniciales se propone una sola VM, evitando mantener varios servidores. Aunque Apache, PHP y MySQL conviven en la misma máquina, son servicios diferenciados. MySQL no se expone a Internet ni a los equipos cliente; solo acepta conexiones locales. La aplicación se publica mediante HTTPS con certificado TLS." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#5B4B00;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="665" width="390" height="155" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Nota:&lt;/b&gt; si en el futuro aumenta el uso, MySQL podrá trasladarse a un servidor independiente sin cambiar la separación lógica entre frontend, API y base de datos." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="805" width="840" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>