<mxfile host="app.diagrams.net" modified="2026-10-30T15:45:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="container-catering" name="01 - Diagrama de contenedores"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;Arquitectura · Diagrama de contenedores&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="35" y="25" width="1330" height="55" as="geometry" /></mxCell><mxCell id="system-boundary" value="&lt;b&gt;Sistema de gestión del catering&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FBFE;strokeColor=#1168BD;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fontSize=18;fontColor=#1168BD;" vertex="1" parent="1"><mxGeometry x="270" y="145" width="1085" height="570" as="geometry" /></mxCell><mxCell id="staff" value="&lt;b&gt;Personal del catering&lt;/b&gt;&lt;br&gt;Administrativo&lt;br&gt;Cocinero&lt;br&gt;Jefe de cocina&lt;br&gt;Nutricionista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#08427B;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="190" height="190" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;Aplicación web (SPA)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Interfaz de usuario, formularios, navegación y visualización de documentos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tecnología:&lt;/b&gt; HTML5, CSS3 y JavaScript." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="315" y="300" width="245" height="220" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;API REST / Backend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Autenticación y permisos; reglas de negocio; validación; operaciones sobre los datos; registro de actividad y generación de PDF.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tecnología:&lt;/b&gt; PHP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#2E6DA4;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1"><mxGeometry x="665" y="270" width="300" height="280" as="geometry" /></mxCell><mxCell id="database" value="&lt;b&gt;Base de datos&lt;/b&gt;&lt;br&gt;&lt;br&gt;Usuarios y perfiles, proveedores, productos, albaranes, almacenes, escandallos, etiquetas, facturas e historial.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tecnología:&lt;/b&gt; MySQL." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#1168BD;strokeColor=#0B5394;fontColor=#FFFFFF;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1060" y="310" width="245" height="210" as="geometry" /></mxCell><mxCell id="r1" value="&lt;b&gt;1.&lt;/b&gt; HTTPS&lt;br&gt;Acceso desde navegador" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="staff" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r2" value="&lt;b&gt;2.&lt;/b&gt; HTTPS · REST/JSON&lt;br&gt;Peticiones y respuestas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frontend" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="r3" value="&lt;b&gt;3.&lt;/b&gt; SQL mediante PDO&lt;br&gt;Lectura y escritura" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=13;fontColor=#263238;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="database"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="note1" value="&lt;b&gt;Seguridad:&lt;/b&gt; el backend comprueba la sesión y el perfil antes de cada operación. La interfaz no es la única barrera de autorización. Las contraseñas se almacenan mediante hash y el acceso se realiza por HTTPS." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#5B4B00;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="315" y="585" width="650" height="90" as="geometry" /></mxCell><mxCell id="note2" value="&lt;b&gt;Sin servicios externos:&lt;/b&gt; los requisitos actuales no necesitan pasarela de pago, correo ni mensajería. La generación de PDF se realiza dentro del backend." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;fontColor=#5B4B00;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="1000" y="585" width="305" height="90" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Relaciones:&lt;/b&gt; flechas = comunicación entre contenedores." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="35" y="755" width="600" height="35" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>